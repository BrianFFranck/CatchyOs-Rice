# Junji Ito cava (terminal): vertical, monochrome, smoky gradient.
[general]
framerate = 60
bars = 0
bar_width = 2
bar_spacing = 1
sleep_timer = 5

[input]
method = pipewire
source = auto

[output]
method = ncurses
orientation = left
channels = stereo
mono_option = average

[color]
background = default
gradient = 1
gradient_color_1 = '#1a1a1a'
gradient_color_2 = '#3a3a3a'
gradient_color_3 = '#6e6e6e'
gradient_color_4 = '#a8a8a8'
gradient_color_5 = '#d9d7d2'
gradient_color_6 = '#f5f3ee'

[smoothing]
monstercat = 0
waves = 1
noise_reduction = 77

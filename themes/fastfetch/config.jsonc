// Junji Ito fastfetch: Uzumaki spiral logo, ink and paper palette.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/spiral.txt",
    "color": { "1": "97", "2": "37", "3": "90" },
    "padding": { "top": 1, "left": 2, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "90", "title": "97", "output": "37" },
    "key": { "width": 11 }
  },
  "modules": [
    { "type": "custom", "format": "\u001b[97m  う ず ま き \u001b[90m·\u001b[37m 富 江 \u001b[90m·\u001b[37m 双 一" },
    { "type": "custom", "format": "\u001b[90m  ────────────────────────────" },
    { "type": "os",       "key": "  os",       "format": "{3}" },
    { "type": "kernel",   "key": "  kernel" },
    { "type": "uptime",   "key": "  awake" },
    { "type": "packages", "key": "  souls" },
    { "type": "shell",    "key": "  shell" },
    { "type": "wm",       "key": "  wm" },
    { "type": "terminal", "key": "  terminal" },
    { "type": "cpu",      "key": "  cpu", "format": "{1}" },
    { "type": "gpu",      "key": "  gpu", "format": "{2}" },
    { "type": "memory",   "key": "  memory" },
    { "type": "disk",     "key": "  disk", "folders": "/" },
    { "type": "custom", "format": "\u001b[90m  ────────────────────────────" },
    { "type": "colors", "symbol": "circle", "paddingLeft": 2 }
  ]
}

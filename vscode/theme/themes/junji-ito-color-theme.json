  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment", "string.quoted.docstring", "string.quoted.docstring.multi.python"],
      "settings": { "foreground": "#5f5d58", "fontStyle": "italic" }
    },
    {
      "name": "Keywords and storage",
      "scope": ["keyword", "keyword.control", "storage", "storage.type", "storage.modifier", "keyword.other.important"],
      "settings": { "foreground": "#b52a2a" }
    },
    {
      "name": "Operators and punctuation",
      "scope": ["keyword.operator", "punctuation", "meta.brace", "punctuation.separator", "punctuation.terminator"],
      "settings": { "foreground": "#7a7874" }
    },
    {
      "name": "Logical word operators",
      "scope": ["keyword.operator.logical.python", "keyword.operator.word", "keyword.operator.new", "keyword.operator.expression"],
      "settings": { "foreground": "#b52a2a" }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted", "punctuation.definition.string"],
      "settings": { "foreground": "#a39d8c" }
    },
    {
      "name": "String escapes and interpolation",
      "scope": ["constant.character.escape", "constant.character.format.placeholder", "meta.fstring.python punctuation.definition", "constant.other.placeholder", "string.regexp"],
      "settings": { "foreground": "#d0b8a0" }
    },
    {
      "name": "Numbers and constants",
      "scope": ["constant.numeric", "constant.language", "constant.other", "support.constant", "variable.other.constant"],
      "settings": { "foreground": "#a39494" }
    },
    {
      "name": "Functions",
      "scope": ["entity.name.function", "meta.function-call.generic", "support.function", "variable.function"],
      "settings": { "foreground": "#f5f3ee" }
    },
    {
      "name": "Function definitions",
      "scope": ["meta.function entity.name.function", "entity.name.function.python"],
      "settings": { "foreground": "#f5f3ee", "fontStyle": "bold" }
    },
    {
      "name": "Builtin functions",
      "scope": ["support.function.builtin", "support.function.magic"],
      "settings": { "foreground": "#c2c8c8" }
    },
    {
      "name": "Classes and types",
      "scope": ["entity.name.type", "entity.name.class", "support.class", "support.type", "entity.other.inherited-class", "storage.type.class.python meta.class"],
      "settings": { "foreground": "#c9c3b2", "fontStyle": "italic" }
    },
    {
      "name": "Variables",
      "scope": ["variable", "variable.other", "meta.definition.variable"],
      "settings": { "foreground": "#d9d7d2" }
    },
    {
      "name": "Parameters",
      "scope": ["variable.parameter", "meta.function.parameters variable"],
      "settings": { "foreground": "#a8a6a1", "fontStyle": "italic" }
    },
    {
      "name": "self / cls / this",
      "scope": ["variable.language", "variable.parameter.function.language.special.self.python", "variable.language.special.self.python", "variable.parameter.function.language.special.cls.python"],
      "settings": { "foreground": "#7d6f6f", "fontStyle": "italic" }
    },
    {
      "name": "Decorators and annotations",
      "scope": ["meta.function.decorator", "entity.name.function.decorator", "punctuation.definition.decorator", "storage.type.annotation", "meta.decorator"],
      "settings": { "foreground": "#8f1d1d", "fontStyle": "italic" }
    },
    {
      "name": "Properties and attributes",
      "scope": ["variable.other.property", "variable.other.object.property", "meta.attribute", "entity.other.attribute-name", "support.variable.property"],
      "settings": { "foreground": "#c8c6c1" }
    },
    {
      "name": "Modules / namespaces",
      "scope": ["entity.name.namespace", "entity.name.module", "meta.import entity.name"],
      "settings": { "foreground": "#9aa0a0" }
    },
    {
      "name": "Tags (HTML/XML)",
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "#b52a2a" }
    },
    {
      "name": "CSS/JSON keys",
      "scope": ["support.type.property-name", "meta.object-literal.key", "support.type.property-name.json"],
      "settings": { "foreground": "#c8c6c1" }
    },
    {
      "name": "Markdown headings",
      "scope": ["markup.heading", "entity.name.section"],
      "settings": { "foreground": "#f5f3ee", "fontStyle": "bold" }
    },
    { "scope": "markup.bold", "settings": { "fontStyle": "bold" } },
    { "scope": "markup.italic", "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.inline.raw", "markup.fenced_code"], "settings": { "foreground": "#a39d8c" } },
    { "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "#b52a2a" } },
    { "scope": "markup.inserted", "settings": { "foreground": "#b0b0b0" } },
    { "scope": "markup.deleted", "settings": { "foreground": "#b52a2a" } },
    { "scope": "markup.changed", "settings": { "foreground": "#c9c3b2" } },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#f5f3ee", "background": "#8f1d1d" }
    }
  ],
  "semanticTokenColors": {
    "function.declaration": { "foreground": "#f5f3ee", "bold": true },
    "method.declaration": { "foreground": "#f5f3ee", "bold": true },
    "function": "#f5f3ee",
    "method": "#f5f3ee",
    "function.builtin": "#c2c8c8",
    "class": { "foreground": "#c9c3b2", "italic": true },
    "class.builtin": { "foreground": "#c9c3b2", "italic": true },
    "type": { "foreground": "#c9c3b2", "italic": true },
    "enumMember": "#a39494",
    "parameter": { "foreground": "#a8a6a1", "italic": true },
    "selfParameter": { "foreground": "#7d6f6f", "italic": true },
    "clsParameter": { "foreground": "#7d6f6f", "italic": true },
    "variable": "#d9d7d2",
    "variable.readonly": "#a39494",
    "property": "#c8c6c1",
    "namespace": "#9aa0a0",
    "module": "#9aa0a0",
    "decorator": { "foreground": "#8f1d1d", "italic": true },
    "builtinConstant": "#a39494"
  }
}
